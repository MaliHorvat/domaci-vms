{
  "name": "visionone-kamere",
  "productName": "VisionOne Kamere",
  "version": "1.0.0",
  "description": "Namizna aplikacija za domači VMS: živa slika, posnetki in dogodki kamer",
  "author": "VisionOne",
  "license": "UNLICENSED",
  "private": true,
  "main": "app/main.js",
  "scripts": {
    "start": "electron .",
    "dist:win": "electron-builder --win --publish never",
    "dist:mac": "electron-builder --mac --publish never"
  },
  "devDependencies": {
    "electron": "33.2.1",
    "electron-builder": "25.1.8"
  },
  "build": {
    "appId": "si.visionone.kamere",
    "productName": "VisionOne Kamere",
    "copyright": "VisionOne",
    "directories": { "output": "dist", "buildResources": "build" },
    "files": ["app/**/*", "build/icon.png", "build/tray.png", "package.json"],
    "win": {
      "target": [{ "target": "nsis", "arch": ["x64"] }],
      "icon": "build/icon.ico",
      "artifactName": "VisionOne-Kamere-Setup.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "VisionOne Kamere",
      "installerLanguages": ["sl_SI"],
      "language": "1060"
    },
    "mac": {
      "target": [{ "target": "dmg", "arch": ["universal"] }],
      "icon": "build/icon.png",
      "category": "public.app-category.utilities",
      "artifactName": "VisionOne-Kamere.${ext}"
    }
  }
}
