# Kopirajte v datoteko .env in prilagodite. Docker Compose jo prebere samodejno.

# Skrbnik ob prvem zagonu (geslo kasneje spremenite v aplikaciji: Admin → Sistem)
ADMIN_USER=admin
ADMIN_PASSWORD=Spremeni-me-2026

# Ime, ki ga vidite v aplikaciji
SYSTEM_NAME=Doma

# IP naslov NAS-a ali mini PC-ja v domačem omrežju
HOST_IP=192.168.1.20

# Naslov NAS-a v VPN-ju (Tailscale: 100.x.y.z, viden v aplikaciji Tailscale; WireGuard: npr. 10.8.0.1). Vpišite po namestitvi VPN-ja.
VPN_HOST=

# Ključ za Tailscale (login.tailscale.com → Settings → Keys → Generate auth key). Potreben samo za --profile vpn.
TS_AUTHKEY=
TS_HOSTNAME=domaci-vms

# Mapa za posnetke (Synology: /volume1/kamere, QNAP: /share/kamere, Windows: D:/kamere)
RECORDINGS_PATH=./recordings

# Vrata strežnika in vrata za živo sliko WebRTC (spremenite, če so zasedena)
VMS_PORT=8080
WEBRTC_PORT=8555

# Koliko dni ostanete prijavljeni v namizni aplikaciji in na telefonu
REMEMBER_DAYS=60

TZ=Europe/Ljubljana

# Ključ za podpis prijave in šifriranje gesel kamer (openssl rand -hex 32). Prazno = samodejno v data/vms/.secret
SECRET_KEY=

# AI zaznavanje oseb in vozil (neobvezno): vpišite dolg naključen niz (npr. 40 črk in številk).
# Ko je nastavljen, zagon.bat / zagon.sh zažene tudi AI modul.
AI_TOKEN=
AI_MODEL=yolo11n.pt
